{
  "description": "Load the routing rule and enforce only CQO mechanical contracts.",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/hooks/burst-mode.cjs\"",
            "commandWindows": "node \"$env:PLUGIN_ROOT\\hooks\\burst-mode.cjs\"",
            "timeout": 15
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/hooks/inject-routing-policy.cjs\"",
            "commandWindows": "node \"$env:PLUGIN_ROOT\\hooks\\inject-routing-policy.cjs\"",
            "timeout": 5,
            "statusMessage": "加载质量路由规则",
            "additionalContextLimit": 2500
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "^(spawn_agent|Agent|collaborationspawn_agent|collaboration\\.spawn_agent)$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/hooks/enforce-agent-routing.cjs\"",
            "commandWindows": "node \"$env:PLUGIN_ROOT\\hooks\\enforce-agent-routing.cjs\"",
            "timeout": 5,
            "statusMessage": "检查代理路由"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "^(luna_worker|sol_medium_worker|terra_worker|sol_reviewer)$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/hooks/continue-capacity-subagent.cjs\"",
            "commandWindows": "node \"$env:PLUGIN_ROOT\\hooks\\continue-capacity-subagent.cjs\"",
            "timeout": 5,
            "statusMessage": "检查子代理容量恢复"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/hooks/continue-capacity-subagent.cjs\"",
            "commandWindows": "node \"$env:PLUGIN_ROOT\\hooks\\continue-capacity-subagent.cjs\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
