{
  "schemaVersion": 8,
  "policyVersion": "0.7.1",
  "toolNames": [
    "spawn_agent",
    "Agent",
    "collaborationspawn_agent",
    "collaboration.spawn_agent"
  ],
  "workPacket": {
    "hostVisibleTaskNamePattern": "^(luna_max|sol_medium|terra_(?:xhigh|max|ultra)|sol_reviewer_xhigh)__([a-z0-9][a-z0-9_]{1,47})$",
    "hostVisibleTaskNameExample": "luna_max__unit_name"
  },
  "capacityRecovery": {
    "message": "Selected model is at capacity. Please try a different model.",
    "automaticContinuationPrompt": "\u7ee7\u7eed"
  },
  "radarEvidence": {
    "enabled": true,
    "sourceUrl": "https://codexradar.com/api/intelligence-efficiency",
    "refreshSeconds": 86400,
    "maxStaleSeconds": 259200,
    "requestTimeoutMs": 1800,
    "maxResponseBytes": 12582912,
    "minSamples": 30,
    "iqTieMargin": 3.0,
    "lunaMaxAlwaysFirstWhenCapable": true
  },
  "namedAgents": {
    "luna_worker": {
      "profileFile": "luna-worker.toml",
      "model": "gpt-5.6-luna",
      "effortMode": "fixed",
      "fixedEffort": "max"
    },
    "sol_medium_worker": {
      "profileFile": "sol-medium-worker.toml",
      "model": "gpt-5.6-sol",
      "effortMode": "fixed",
      "fixedEffort": "medium"
    },
    "terra_worker": {
      "profileFile": "terra-worker.toml",
      "model": "gpt-5.6-terra",
      "effortMode": "required",
      "allowedEfforts": [
        "xhigh",
        "max",
        "ultra"
      ]
    },
    "sol_reviewer": {
      "profileFile": "sol-reviewer.toml",
      "model": "gpt-5.6-sol",
      "effortMode": "fixed",
      "fixedEffort": "xhigh",
      "sandboxMode": "read-only"
    }
  },
  "retiredProfiles": [],
  "burstMode": {
    "enabledByExactCommand": "\u5f00\u542f\u7206\u79cd\u6a21\u5f0f",
    "disabledByExactCommand": "\u5173\u95ed\u7206\u79cd\u6a21\u5f0f",
    "maxChildThreads": 25,
    "depths": [1, 2, 3, 4],
    "depthTaskNamePattern": "__d[1-4]_",
    "packetFields": ["burst_depth", "burst_delegate"]
  },
  "forkTurns": {
    "allowedLiterals": [
      "none"
    ],
    "allowPositiveIntegerString": true
  }
}
