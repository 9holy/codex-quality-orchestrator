        "xhigh",
        "max"
      ]
    },
    "luna_worker": {
      "profileFile": "luna-worker.toml",
      "model": "gpt-5.6-luna",
      "effortMode": "fixed",
      "fixedEffort": "max"
    },
    "sol_reviewer": {
      "profileFile": "sol-reviewer.toml",
      "model": "gpt-5.6-sol",
      "effortMode": "fixed",
      "fixedEffort": "xhigh",
